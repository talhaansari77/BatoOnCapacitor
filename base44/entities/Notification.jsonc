{
  "name": "Notification",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string",
      "description": "Email of the client"
    },
    "type": {
      "type": "string",
      "enum": [
        "reminder",
        "feedback",
        "appointment_update",
        "treatment_update",
        "message",
        "general"
      ],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal",
      "description": "Notification priority"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification has been read"
    },
    "read_date": {
      "type": "string",
      "format": "date-time",
      "description": "When notification was read"
    },
    "related_id": {
      "type": "string",
      "description": "ID of related entity (appointment, session, etc.)"
    },
    "related_type": {
      "type": "string",
      "enum": [
        "appointment",
        "session",
        "message",
        "order",
        "feedback"
      ],
      "description": "Type of related entity"
    },
    "action_url": {
      "type": "string",
      "description": "URL to navigate when notification is clicked"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When notification expires"
    }
  },
  "required": [
    "client_email",
    "type",
    "title",
    "message"
  ]
}