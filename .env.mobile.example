# Copy to .env.mobile.local. Vite bundles these PUBLIC values into client code.
# Node.js REST backend root. The feature screens are NOT connected yet.
# Use HTTPS in production. Ensure the backend accepts Capacitor origins.
VITE_API_BASE_URL=

# Optional: legacy Base44 runtime settings if continuing to use its backend.
# Base44 auth redirects still need a native-compatible login flow.
VITE_BASE44_APP_ID=
VITE_BASE44_BACKEND_URL=

# NEVER add backend secrets, signing keys, database URLs, or private tokens.
